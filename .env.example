# ==========================================
# VeraFit AI — Global Configuration (.env.example)
# ==========================================

# Environment & Server
ENVIRONMENT=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=5194
FRONTEND_PORT=5193
NEXT_PUBLIC_API_URL=http://localhost:5194/api/v1

# Security & Sessions
SECRET_KEY=verafit-super-secret-jwt-key-change-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite stored in data/ folder by default, PostgreSQL ready)
DATABASE_URL=sqlite+aiosqlite:///./data/verafit.db

# Third-Party AI & Vision APIs
YOUCAM_API_KEY=
YOUCAM_API_URL=https://api.youcam.ai/v1
YOUCAM_MOCK_FALLBACK=true

# LiteLLM Unified Model Provider Configuration
# Supported: OpenAI (gpt-4o), Ollama (ollama/llama3.2), Anthropic, Gemini, Groq, OpenRouter
LLM_MODEL=gpt-4o
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_API_BASE=http://localhost:11434

# Asset & Image URL Defaults
NEXT_PUBLIC_DEFAULT_AVATAR_URL=https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150&auto=format&fit=crop&q=80
NEXT_PUBLIC_DEFAULT_MANNEQUIN_PHOTO_URL=https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=600&auto=format&fit=crop&q=80
NEXT_PUBLIC_DEFAULT_GARMENT_IMAGE_URL=https://images.unsplash.com/photo-1576566588028-4147f3842f27?w=600&auto=format&fit=crop&q=80
DEFAULT_AVATAR_URL=https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150&auto=format&fit=crop&q=80
DEFAULT_MANNEQUIN_PHOTO_URL=https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=600&auto=format&fit=crop&q=80
DEFAULT_GARMENT_IMAGE_URL=https://images.unsplash.com/photo-1576566588028-4147f3842f27?w=600&auto=format&fit=crop&q=80

# Application Preferences & Algorithmic Weights
DEFAULT_WEIGHT_FIT=0.45
DEFAULT_WEIGHT_COLOR=0.30
DEFAULT_WEIGHT_FABRIC=0.25
ALLERGY_PENALTY_MULTIPLIER=0.40
SSIM_INSTABILITY_THRESHOLD=0.80
